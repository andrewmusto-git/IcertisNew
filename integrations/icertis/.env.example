# Icertis SaaS connector configuration
# Copy this file to .env and replace placeholders before running the connector.

# Required for live SaaS queries
ICERTIS_BASE_URL=https://westrock
# Derived automatically from the base URL when left blank
ICERTIS_USERS_URL=https://westrock-api.icertis.com/api/Users
ICERTIS_GROUPS_URL=https://westrock-api.icertis.com/api/Groups
ICERTIS_ORG_UNITS_URL=https://westrock-business-api.icertis.com/api/v1/organizationunits
ICERTIS_USERS_PATH=/api/v1/users
ICERTIS_ROLES_PATH=/api/v1/roles
ICERTIS_PERMISSIONS_PATH=/api/v1/permissions
ICERTIS_GRANT_TYPE=client_credentials

# Preferred auth: OAuth2 client credentials
ICERTIS_CLIENT_ID=your_client_id_here
ICERTIS_CLIENT_SECRET=your_client_secret_here
ICERTIS_TOKEN_URL=https://login.microsoftonline.com/<tenant-id>/oauth2/v2.0/token
ICERTIS_SCOPE=api://your-app-id/.default
ICERTIS_OAUTH_REQUEST_PARAMETERS={"scope":"api://your-app-id/.default"}

# Alternative auth: direct API token or API key
# ICERTIS_API_TOKEN=your_bearer_token_here
# ICERTIS_API_KEY=your_api_key_here

# Veza configuration
VEZA_URL=https://your-veza-instance.example.com
VEZA_API_KEY=your_veza_api_key_here

# Optional overrides
# PROVIDER_NAME=Icertis
# DATASOURCE_NAME=Icertis-Production
